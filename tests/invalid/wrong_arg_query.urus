// Default-valued parameter followed by non-default parameter must
// be rejected. (Originally written as `fn test(...)`; renamed to
// avoid colliding with the reserved `test` keyword.)

fn greet(name: str = "John" + "Fried", age: int) {
    print(f"Hi {name}!. Are you {age + 20} year old?");
    print(f"{name}: NO, im {age} year old");
}

fn main() {
    greet();
}
