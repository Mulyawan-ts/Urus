// Regression for the silent miscompile fixed in PR #193: when
// emit_single_tuple_typedef() recursed into nested tuple types it
// clobbered the static buffer that held the *outer* tuple's name,
// so the outer typedef and its _drop function ended up emitted with
// the inner tuple's name. The compile would succeed (the C is
// well-formed) but use the wrong types — silent miscompile.
//
// We're only checking that the codegen emits distinct typedefs for
// nested tuple shapes; we don't try to read the inner fields back
// (the lexer can't disambiguate `pair.0.0` from `pair . FLOAT`, and
// destructuring through `let inner = pair.0` currently double-frees
// at runtime — a separate bug tracked as a follow-up). Just having
// the program compile and run cleanly is what the typedef-name
// audit needs.

fn make_inner(): (int, int) {
    return (7, 8);
}

fn make_outer(): ((int, int), str) {
    let inner: (int, int) = make_inner();
    return (inner, "outer");
}

fn main(): void {
    let pair: ((int, int), str) = make_outer();
    print(pair.1);
    print("done");
}
