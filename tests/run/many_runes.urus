rune r31(x) { x + 31 }
rune r32(x) { x + 32 }
rune r33(x) { x + 33 }
rune r34(x) { x + 34 }
rune r35(x) { x + 35 }
rune r36(x) { x + 36 }
rune r37(x) { x + 37 }
rune r38(x) { x + 38 }
rune r39(x) { x + 39 }
rune r40(x) { x + 40 }
rune r41(x) { x + 41 }
rune r42(x) { x + 42 }
rune r43(x) { x + 43 }
rune r44(x) { x + 44 }
rune r45(x) { x + 45 }
rune r46(x) { x + 46 }
