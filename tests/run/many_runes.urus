// Regression for PR #188 (dynamic limits): defining more than the old
// MAX_RUNES=64 cap previously caused the rune table to overflow.
// We register 80 distinct runes and use a few of them; if the table
// still has a hard cap, this fails to compile or silently drops runes.

rune r0(x) { x + 0 }
rune r1(x) { x + 1 }
